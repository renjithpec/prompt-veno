# ============================================
# PUBLIC KEYS (safe for client-side / browser)
# ============================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# SECRET KEYS (server-side ONLY — NEVER expose to browser)
# ============================================
# The service role key bypasses RLS. Keep it server-side only.
# It is used in lib/supabase/server.ts createSupabaseAdminClient()
# and NEVER imported in any "use client" file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
